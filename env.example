DISCORD_TOKEN=your_discord_bot_token
API_KEY=your_MCS_dashboard_api
API_BASE=your_MCS_IP_address
DAEMON_ID=your_MCS_daemon_UID
ALLOWED_USER_IDS=["your_discord_users_UID"]
ALLOWED_ROLE_IDS=["your_discord_roles_UID"]
CLIENT_ID=your_discord_bot_client_UID
GUILD_IDS=["your_discord_server_UID"]
DASHBOARD_CHANNEL_IDS=["your_discord_dashboard_channel_UID"]
DASHBOARD_INTERVAL_MS=60000
NETBIRD_API_URL=https://your_netbird_domain
NETBIRD_TOKEN=your_netbird_personal_access_token
NETBIRD_AUTO_GROUPS=["your_netbird_group_id"]
NETBIRD_CONTAINER=netbird-server
NETBIRD_CONFIG=/etc/netbird/config.yaml
DOCKER_GID=999
